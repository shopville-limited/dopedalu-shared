{
  "name": "@dopedalu/shared",
  "version": "0.4.0",
  "description": "Framework-agnostická sdílená data + logika pro dopedalu.cz zóny (portál, blog, bazar, mapa, akce): design tokeny, cross-zone konstanty, jednotná navigace a patička, search provider a Zod schémata. Distribuováno jako HTTPS tarball z GitHub tagu; dist je commitnutý, konzumenti build nespouští.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./nav": {
      "types": "./dist/nav.d.ts",
      "import": "./dist/nav.js"
    },
    "./footer": {
      "types": "./dist/footer.d.ts",
      "import": "./dist/footer.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "zod": "^3.23.0"
  }
}
