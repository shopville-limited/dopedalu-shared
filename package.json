{
  "name": "@dopedalu/shared",
  "version": "0.1.0",
  "description": "Framework-agnostická sdílená data pro dopedalu.cz zóny (portál, blog, bazar, mapa, akce): design tokeny a cross-zone konstanty. Distribuováno jako git-dependency z GitHub tagu; dist je commitnutý, konzumenti build nespouští.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
